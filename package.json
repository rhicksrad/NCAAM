{
  "name": "field-house",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "snapshot": "tsx scripts/snapshot.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "budget": "node scripts/check-budget.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run budget && pnpm run smoke"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/big-shoulders": "^5.3.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
